# Base URL API backend. Salin file ini jadi .env sebelum build/dev.
#
# Yang dipakai dipilih otomatis berdasarkan NODE_ENV (lihat src/lib/urlEndPoint.js):
#   next dev          -> NEXT_PUBLIC_API_BASE_URL_DEV
#   next build        -> tujuan proxy API pada server frontend
#
# Keduanya ditanam ke bundel SAAT BUILD, bukan dibaca saat server menyala:
# yang berlaku adalah nilai di file ini ketika `next build` dijalankan.
# Kalau nilainya kosong, build akan berhenti dengan pesan error.
#
# Dev: port backend = PORT di backend-ac/.env
NEXT_PUBLIC_API_BASE_URL_DEV=http://localhost:3001

# Produksi: isi sesuai server yang dipakai.
NEXT_PUBLIC_API_BASE_URL_PRODUCTION=http://192.128.69.69:3001
